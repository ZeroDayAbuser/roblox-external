    inline const char* brick_color_name( std::int32_t id )
    {
        switch ( id )
        {
        case 1: return "White"; case 2: return "Grey"; case 21: return "Bright red";
        case 23: return "Bright blue"; case 24: return "Bright yellow"; case 26: return "Black";
        case 28: return "Dark green"; case 37: return "Bright green"; case 104: return "Bright violet";
        case 106: return "Bright orange"; case 119: return "Br. yellowish green"; case 1001: return "Institutional white";
        case 1003: return "Really black"; case 1004: return "Really red"; case 1010: return "Really blue";
        case 1013: return "Cyan"; case 1020: return "Hot pink"; default: return nullptr;
